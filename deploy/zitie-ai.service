[Unit]
Description=Zitie DeepSeek poetry lookup
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zitie-ai
Group=zitie-ai
WorkingDirectory=/opt/zitie-ai
ExecStart=/usr/bin/python3 /opt/zitie-ai/ai.py
EnvironmentFile=/etc/zitie/ai.env
Environment=ZITIE_STATE_DIR=/var/lib/zitie
Environment=PYTHONDONTWRITEBYTECODE=1
StateDirectory=zitie
StateDirectoryMode=0700
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
